{
  "name": "Workout Analytics Chat",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [8501],
  "portsAttributes": { "8501": { "label": "Streamlit" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "tamasfe.even-better-toml"]
    }
  }
}
